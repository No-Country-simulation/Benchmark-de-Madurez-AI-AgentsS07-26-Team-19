# Variables para docker compose (raíz del repo). Copiar a .env y ajustar antes de desplegar.
POSTGRES_USER=nlr
POSTGRES_PASSWORD=nlr_secret
POSTGRES_DB=nlr_diagnostic

# Puerto del API en el host
API_PORT=8000

# Producción:
ENVIRONMENT=production
DEBUG=false
LOG_JSON=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PDF service
PDF_SERVICE_TIMEOUT_SECONDS=30

# AI analysis — protocolo OpenAI-compatible (Ollama local o Hugging Face router)
# Local:   AI_SERVICE_URL=http://localhost:11434 + HF_TOKEN vacío
# Nube:    AI_SERVICE_URL=https://router.huggingface.co + HF_TOKEN=<hf_...>
AI_SERVICE_URL=https://router.huggingface.co
HF_TOKEN=
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct