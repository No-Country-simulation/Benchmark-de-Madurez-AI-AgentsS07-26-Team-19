# App
APP_NAME="NLR Diagnostic API"
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nlr
POSTGRES_PASSWORD=nlr_secret
POSTGRES_DB=nlr_diagnostic
POSTGRES_MIN_POOL_SIZE=0
POSTGRES_MAX_POOL_SIZE=3
# Supabase exige TLS: poner true y usar el pooler (puerto 6543) al desplegar.
POSTGRES_SSL=false

# Security
ANON_SESSION_TTL_SECONDS=86400
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Confiar en X-Forwarded-For del proxy (true solo tras un proxy inverso de confianza)
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Puppeteer PDF service — opcional (solo local). En producción el frontend
# genera el PDF; dejar vacío para que /report/pdf responda 501.
PDF_SERVICE_URL=http://localhost:3001
PDF_SERVICE_TIMEOUT_SECONDS=30

# AI analysis service — protocolo OpenAI-compatible.
# Local (Ollama): AI_SERVICE_URL=http://localhost:11434 + modelo NeuralQwen
# Nube (Hugging Face Inference Providers): AI_SERVICE_URL=https://router.huggingface.co
#   + HF_TOKEN=<token read hf_...> + AI_MODEL=meta-llama/Llama-3.3-70B-Instruct
AI_SERVICE_URL=http://localhost:11434
HF_TOKEN=
AI_MODEL=hf.co/mradermacher/NeuralQwen-2.5-1.5B-Spanish-GGUF:Q4_K_M
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=512

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Swagger en producción (usuario "swagger"): vacío => /docs deshabilitado.
SWAGGER_PASSWORD=
