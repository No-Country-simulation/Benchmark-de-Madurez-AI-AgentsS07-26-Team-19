# App
APP_NAME="NLR Diagnostic API"
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nlr
POSTGRES_PASSWORD=nlr_secret
POSTGRES_DB=nlr_diagnostic
POSTGRES_MIN_POOL_SIZE=2
POSTGRES_MAX_POOL_SIZE=10

# Security
ANON_SESSION_TTL_SECONDS=86400
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Puppeteer PDF service
PDF_SERVICE_URL=http://localhost:3001
PDF_SERVICE_TIMEOUT_SECONDS=30

# AI analysis service (Ollama)
AI_SERVICE_URL=http://localhost:11434
AI_MODEL=hf.co/mradermacher/NeuralQwen-2.5-1.5B-Spanish-GGUF:Q4_K_M
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=512

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
